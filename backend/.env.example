# Copy this file to .env and fill in values. Never commit .env.

# Free key from https://aistudio.google.com/apikey — leave empty to run without AI coaching.
# Note: on Gemini's free tier, Google may use submitted text to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Origins allowed to call this API (comma-separated). Add your deployed app URL here.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
